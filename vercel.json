{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/courses/sgt.ts": { "maxDuration": 60 },
    "api/courses/scorecard.ts": { "maxDuration": 60 },
    "api/**/*.ts": { "maxDuration": 15 }
  },
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "30 9 * * *" }
  ]
}
