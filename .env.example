# Vorlage. Die echten Werte gehören in .env.local (von Git ausgeschlossen)
# oder direkt in die Environment Variables des Vercel-Projekts.

# Neon-Postgres: Connection String der Datenbank "wintigolf"
DATABASE_URL=

# Brevo (transaktionale Mails: Einladung, Reminder, Bestätigungen)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@crossfitgleis10.ch
BREVO_SENDER_NAME=Wintigolf League

# GolfCourseAPI (nur für Course Rating / Slope, wenn GSPro sie nicht hergibt)
GOLF_COURSE_API_KEY=
GOLF_COURSE_API_DAILY_BUDGET=40

